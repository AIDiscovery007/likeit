--- a/native/DesktopDiagnostics.swift
+++ b/native/DesktopDiagnostics.swift
@@ -0,0 +1,26 @@
+import Foundation
+import OSLog
+
+private enum DesktopDiagnostics {
+    static let lock = NSLock()
+    static let logger = Logger(subsystem: "com.likeit.desktop", category: "diagnostics")
+    static var count = 0
+}
+
+func desktopDiagnostic(_ message: String) {
+#if LIKEIT_AUDIO_DIAGNOSTICS
+    DesktopDiagnostics.lock.lock()
+    defer { DesktopDiagnostics.lock.unlock() }
+    guard DesktopDiagnostics.count < 256 else { return }
+    DesktopDiagnostics.count += 1
+    let event = DesktopDiagnostics.count == 256 ? "diagnostics-truncated limit=256" : message
+    DesktopDiagnostics.logger.notice("seq=\(DesktopDiagnostics.count, privacy: .public) uptime=\(ProcessInfo.processInfo.systemUptime, privacy: .public) \(event, privacy: .public)")
+#endif
+}
+
+func diagnosticStatus(_ status: Int32) -> String {
+    let value = UInt32(bitPattern: status)
+    let bytes = [24, 16, 8, 0].map { UInt8((value >> $0) & 255) }
+    let fourCC = bytes.allSatisfy { (32...126).contains($0) } ? String(bytes: bytes, encoding: .ascii)! : "nonprintable"
+    return "status=\(status) hex=\(String(format: "%08X", value)) fourCC=\(fourCC)"
+}
